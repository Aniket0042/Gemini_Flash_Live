# Replace with your actual Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Live API Model (Optional, defaults to models/gemini-3.1-flash-live-preview)
# Other options: models/gemini-3.8-live, models/gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Live Voice (Optional, defaults to Achird)
# Options: Achird, Gacrux, Pulcherrima, Zubenelgenubi, Vindemiatrix, Zephyr, Puck, Charon, Aoede, Fenrir, Kore, Pegasus
GEMINI_VOICE=Achird
